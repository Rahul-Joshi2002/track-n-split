PORT=3000

# Trip WhatsApp group, e.g. 1203630xxxxxxxxx@g.us
# Leave empty on first run to log inbound group JIDs only.
GROUP_JID=

# No quotes needed for these. Quotes are fine too, as long as the value has no extra spaces.
GOOGLE_SHEET_ID=1abcYourSheetIdHere

# Preferred: save the downloaded JSON as ./service-account.json (gitignored)
# and point at it. Multiline JSON inside .env will fail to parse.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Alternative for hosts like Render: paste the whole JSON as ONE line.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"trip-expense-bot@your-project.iam.gserviceaccount.com"}

# Secret for the pairing page: /pair?token=...
PAIR_TOKEN=pick-a-long-random-secret

# Your WhatsApp number in international form, no plus, e.g. 9198XXXXXXXX
# Used for on-the-go pairing codes on the same phone.
PAIR_PHONE=9198XXXXXXXX

# Optional override for the group online notice
BOT_ONLINE_MESSAGE=Expense bot is online.

# Optional IANA timezone for Transactions expense_at column (default Asia/Kolkata)
# EXPENSE_TIMEZONE=Asia/Kolkata

# SHIPPING: must be true on the trip. false keeps the group silent (dev).
SEND_GROUP_MESSAGES=false
